# Copy this file to wrangler.toml only after provisioning a DEDICATED Bytova D1.
# Never commit your populated wrangler.toml, admin keys or payment secrets.
name = "bytova-remote-help"
main = "worker.mjs"
compatibility_date = "2026-11-01"
workers_dev = true

[vars]
PUBLIC_SITE_ORIGIN = "https://bytova.co.uk"
PAYMENTS_MODE = "disabled"
# Add the public Turnstile site key only after creating a widget for the worker hostname:
# TURNSTILE_SITE_KEY = "your-public-site-key"

[[d1_databases]]
binding = "DB"
database_name = "bytova-remote-help"
database_id = "REPLACE_WITH_NEW_BYTOVA_D1_DATABASE_ID"
migrations_dir = "migrations"
